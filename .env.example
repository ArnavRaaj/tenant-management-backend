# ==============================================================================
# Nivaasa (निवास) — Backend environment template
# Copy to .env and fill in. NEVER commit real values.
# Variables marked [PROD] are required when NODE_ENV=production (the server
# refuses to start without them).
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Number of reverse-proxy hops in front of the API (load balancer = 1).
# Makes req.ip the real client IP for rate limiting and audit logs.
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# ── MongoDB [PROD] ────────────────────────────────────────────────────────────
# Must be a replica set (Atlas, or mongod --replSet) — transactions are required.
# directConnection=true lets your machine reach the docker-compose replica set
# (its member advertises the in-network hostname "mongo").
MONGO_URI=mongodb://localhost:27017/?directConnection=true
DATABASE_NAME=tenant_management
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
# Dev only: allow a standalone mongod without transactions (ignored in production).
MONGO_ALLOW_STANDALONE=true

# ── Redis (rate limits, cache, background jobs) ───────────────────────────────
# Required for running more than one API instance. Leave blank for a single
# dev instance (in-process fallbacks are used).
REDIS_URL=redis://localhost:6379
# Run BullMQ workers inside this process (set false on API-only instances).
RUN_WORKERS=true

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Comma-separated allow-list; defaults to FRONTEND_URL.
CORS_ORIGINS=

# ── Authentication [PROD] ─────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# lax (same-site deployments) | none (frontend and API on different sites; requires HTTPS)
REFRESH_COOKIE_SAMESITE=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
INVITE_TTL_DAYS=7
KYC_LINK_TTL_HOURS=72

# ── Encryption [PROD] ─────────────────────────────────────────────────────────
# 32-byte key, base64 or 64-char hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Old keys still accepted for decryption during key rotation (comma-separated).
ENCRYPTION_PREVIOUS_KEYS=
# Legacy passphrase used by the pre-v2 AES-CBC data. Keep it set until
# `npm run migrate` has re-encrypted existing tenants, then it may be removed.
ENCRYPTION_PASSWORD=
# [PROD] 32-byte key for blind indexes (phone lookups) and OTP hashing.
# Generate once and NEVER change it: unlike ENCRYPTION_KEY it cannot be rotated
# without recomputing every stored hash. (Dev only: derived if blank.)
HMAC_KEY=

# ── Cloudinary (private Aadhaar document storage) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SIGNED_URL_TTL_SECONDS=600

# ── Email (Resend, Gmail App Password, or any SMTP) [PROD: one of them] ──────
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nivaasa <no-reply@example.com>

# ── Aadhaar e-KYC (mock | surepass) — mock is rejected in production ─────────
KYC_PROVIDER=mock
SUREPASS_API_TOKEN=
SUREPASS_BASE_URL=https://sandbox.surepass.io/api/v1

# ── AI maintenance classification (optional; rule-based fallback) ────────────
GEMINI_API_KEY=

# ── WhatsApp (simulator | meta) ──────────────────────────────────────────────
WHATSAPP_PROVIDER=simulator
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# [PROD] Shared secret for Meta's webhook handshake.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# [PROD with meta] Meta App Secret — verifies X-Hub-Signature-256 on webhooks.
WHATSAPP_APP_SECRET=
# Dev simulator endpoint (/api/whatsapp/dev/simulate-inbound). Never available in production.
ENABLE_WHATSAPP_SIMULATOR=true

# ── Operations ───────────────────────────────────────────────────────────────
EXTERNAL_HTTP_TIMEOUT_MS=8000
AUDIT_RETENTION_DAYS=365
WHATSAPP_LOG_RETENTION_DAYS=180
